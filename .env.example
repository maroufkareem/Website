# Copy to .env.local and fill in. Never commit .env.local.

# ---------- database (Neon) ----------
DATABASE_URL=

# ---------- admin sign-in ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# ---------- transactional email (Resend) ----------
# Used for book-reservation confirmations. Until BOTH are set, reservations
# are still saved and shown in the admin dashboard, but no email is sent and
# the Reservations page shows a warning.
#
#   1. Create an API key at https://resend.com/api-keys
#   2. Verify the sending domain at https://resend.com/domains
#   3. EMAIL_FROM must use that verified domain
RESEND_API_KEY=
EMAIL_FROM="The Marouf Method <hello@drkareemmarouf.com>"
